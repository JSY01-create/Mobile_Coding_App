{
  "name": "mobile-coding-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A code editor for phones with a custom coding keyboard.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single && node scripts/make-single.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "emmet": "^2.4.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
